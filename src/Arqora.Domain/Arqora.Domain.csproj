<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Pragmatic trade-off: We reference the ASP.NET Core framework here so that
       AppUser can inherit from IdentityUser. In strict DDD the Domain layer would
       have zero infrastructure dependencies; see the comment in AppUser.cs. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
